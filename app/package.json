{
    "name": "retroboy-snap",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build:wasm": "../scripts/build-wasm.sh",
        "dev": "vite",
        "build": "tsc --noEmit && vite build && node scripts/generate-sw.mjs",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "check": "npm run build:wasm && npm run typecheck && npm run lint && vite build && node scripts/generate-sw.mjs",
        "deploy": "npm run check && cd .. && npx --yes netlify-cli@27.14.2 deploy --prod --no-build --dir=app/dist"
    },
    "dependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5"
    }
}
