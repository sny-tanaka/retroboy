{
    "name": "retroboy-snap",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build:wasm": "../scripts/build-wasm.sh",
        "build:mgba": "../scripts/build-mgba.sh",
        "test:core": "../scripts/test-core.sh",
        "build:games": "../scripts/build-games.sh",
        "dev": "vite",
        "build": "tsc --noEmit && vite build && node scripts/generate-sw.mjs",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "check": "npm run build:wasm && npm run build:mgba && npm run test:core && ../scripts/build-games.sh --check && npm run check:guide && npm run typecheck && npm run lint && vite build && node scripts/generate-sw.mjs",
        "check:guide": "python3 -I -B ../games/tamers-life-gba/tools/guide_data.py --check && python3 -I -B ../games/tamers-life-gba/tools/guide_icons.py --check",
        "deploy": "../scripts/deploy-pages.sh"
    },
    "dependencies": {
        "jsqr": "1.4.0",
        "qrcode-generator": "2.0.4",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5"
    }
}
