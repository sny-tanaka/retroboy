+    fn transfer_duration(&self) -> u64 {
+        self.get_t_cycle_clock_rate() as u64 * 8
+    }
+
+    fn complete_transfer(&mut self, incoming: u8) {
+        self.data = incoming;
+        self.transfer_enabled = false;
+        self.bits_transferred = 0;
+        self.clock = 0;
+        self.interrupt = true;
+    }
+
+    fn step_linked(&mut self, link: &mut LinkPort) {
+        self.receive_due_transfers(link);
+        self.step_master_linked(link);
+    }
+
+    pub(super) fn receive_due_transfers(&mut self, link: &mut LinkPort) {
+        while let Some((seq, incoming)) = link.take_due_transfer() {
+            let reply = if !self.transfer_enabled {
+                0x00
+            } else if self.is_master {
+                0xFF
+            } else {
+                let outgoing = self.data;
+                self.complete_transfer(incoming);
+                outgoing
+            };
+            link.send_reply(seq, reply);
+        }
+    }
+
+    fn step_master_linked(&mut self, link: &mut LinkPort) {
+        let master_transfer_active = self.transfer_enabled && self.is_master;
+        match link.master() {
+            Some(_) if !master_transfer_active => link.end_master(),
+            Some(transfer) if link.clock() >= transfer.end_at => match transfer.reply {
+                Some(reply) => {
+                    link.end_master();
+                    self.complete_transfer(reply);
+                },
+                None => link.wait_for_reply()
+            },
+            None if master_transfer_active => link.begin_master(self.data, self.transfer_duration()),
+            _ => {}
+        }
+    }
+
+    pub(super) fn write_control_linked(&mut self, value: u8, link: &mut LinkPort) {
+        self.set_control(value);
+        if link.connected() {
+            link.end_master();
+        }
+    }
+
     fn control(&self) -> u8 {
         let transfer_enabled_bit = if self.transfer_enabled { 1 } else { 0 };
         let high_speed_clock_bit = if self.is_high_speed_clock { 1 } else { 0 };
