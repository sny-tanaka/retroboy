+        self.address_bus_mut().receive_due_link_transfers();
+    }
+
+    pub fn deliver_link_reply(&mut self, seq: u32, byte: u8) {
+        self.address_bus_mut().link_mut().deliver_reply(seq, byte);
+    }
+
+    pub fn step_link(&mut self, limit: u64) -> LinkStepResult {
+        loop {
+            let limit = limit.max(self.address_bus().link().next_incoming_at().unwrap_or(0));
+            let link = self.address_bus().link();
+            if link.has_event() {
+                return LinkStepResult::EventPending;
+            }
+            if link.waiting_reply() {
+                return LinkStepResult::WaitingReply;
+            }
+            if self.address_bus().apu().audio_buffers_full() {
+                return LinkStepResult::AudioBufferFull;
+            }
+            if link.clock() >= limit {
+                return LinkStepResult::ReachedLimit;
+            }
+            self.step();
+        }
+    }
+
+    pub fn audio_buffers(&self) -> (&[f32], &[f32]) {
+        let apu = self.address_bus().apu();
+        (apu.get_left_sample_queue(), apu.get_right_sample_queue())
+    }
