+++ b/src/serial/link.rs
@@ -0,0 +1,137 @@
+use std::collections::VecDeque;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LinkEvent {
+    Transfer { seq: u32, at: u64, byte: u8 },
+    Reply { seq: u32, byte: u8 },
+}
+
+#[derive(Clone, Copy)]
+struct IncomingTransfer {
+    seq: u32,
+    at: u64,
+    byte: u8,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct MasterTransfer {
+    pub(crate) end_at: u64,
+    pub(crate) reply: Option<u8>,
+    seq: u32,
+}
+
+pub(crate) struct LinkPort {
+    connected: bool,
+    clock: u64,
+    next_seq: u32,
+    outgoing: VecDeque<LinkEvent>,
+    incoming: VecDeque<IncomingTransfer>,
+    last_incoming: Option<(u64, u64)>,
+    master: Option<MasterTransfer>,
+    waiting_reply: bool,
+}
+
+impl LinkPort {
+    pub(crate) fn new() -> Self {
+        LinkPort {
+            connected: false,
+            clock: 0,
+            next_seq: 0,
+            outgoing: VecDeque::new(),
+            incoming: VecDeque::new(),
+            last_incoming: None,
+            master: None,
+            waiting_reply: false,
+        }
+    }
+
+    pub(crate) fn connected(&self) -> bool {
+        self.connected
+    }
+
+    pub(crate) fn set_connected(&mut self, connected: bool) {
+        *self = LinkPort::new();
+        self.connected = connected;
+    }
+
+    pub(crate) fn clock(&self) -> u64 {
+        self.clock
+    }
+
+    pub(crate) fn tick(&mut self, t_cycles: u8) {
+        if self.connected {
+            self.clock += t_cycles as u64;
+        }
+    }
+
+    pub(crate) fn waiting_reply(&self) -> bool {
+        self.waiting_reply
+    }
+
+    pub(crate) fn has_event(&self) -> bool {
+        !self.outgoing.is_empty()
+    }
+
+    pub(crate) fn take_event(&mut self) -> Option<LinkEvent> {
+        self.outgoing.pop_front()
+    }
+
+    pub(crate) fn deliver_transfer(&mut self, seq: u32, at: u64, byte: u8) {
+        if self.connected {
+            let spaced_at = self.last_incoming
+                .map(|(previous_at, previous_receive_at)| previous_receive_at + at.saturating_sub(previous_at))
+                .unwrap_or(0);
+            let receive_at = at.max(self.clock).max(spaced_at);
+            self.last_incoming = Some((at, receive_at));
+            self.incoming.push_back(IncomingTransfer { seq, at: receive_at, byte });
+        }
+    }
+
+    pub(crate) fn next_incoming_at(&self) -> Option<u64> {
+        self.incoming.front().map(|transfer| transfer.at)
+    }
+
+    pub(crate) fn deliver_reply(&mut self, seq: u32, byte: u8) {
+        if let Some(master) = self.master.as_mut() {
+            if master.seq == seq {
+                master.reply = Some(byte);
+                self.waiting_reply = false;
+            }
+        }
+    }
+
+    pub(crate) fn master(&self) -> Option<MasterTransfer> {
+        self.master
+    }
+
+    pub(crate) fn begin_master(&mut self, byte: u8, duration: u64) {
+        let seq = self.next_seq;
+        self.next_seq = self.next_seq.wrapping_add(1);
+        let end_at = self.clock + duration;
+        self.master = Some(MasterTransfer { end_at, reply: None, seq });
+        self.outgoing.push_back(LinkEvent::Transfer { seq, at: end_at, byte });
+    }
+
+    pub(crate) fn end_master(&mut self) {
+        self.master = None;
+        self.waiting_reply = false;
+    }
+
+    pub(crate) fn wait_for_reply(&mut self) {
+        self.waiting_reply = true;
+    }
+
+    pub(crate) fn take_due_transfer(&mut self) -> Option<(u32, u8)> {
+        match self.incoming.front() {
+            Some(transfer) if transfer.at <= self.clock => {
+                let transfer = self.incoming.pop_front()?;
+                Some((transfer.seq, transfer.byte))
+            },
+            _ => None
+        }
+    }
+
+    pub(crate) fn send_reply(&mut self, seq: u32, byte: u8) {
+        self.outgoing.push_back(LinkEvent::Reply { seq, byte });
+    }
+}
