From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: retroboy-snap <retroboy-snap@localhost>
Date: Tue, 27 Oct 2026 14:31:04 +0900
Subject: [PATCH] Build without threads for Emscripten
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

retroboy-snap は mGBA を WASM にして GitHub Pages で配る。Pages は COOP/COEP のヘッダを付けられず、
SharedArrayBuffer（WASM のスレッド）を使うには Service Worker でヘッダを付け直す細工が要る。
GBA のコアは 1 フレームずつ JS から進めればよいので、Emscripten ではスレッドを使わずに作る
（UNIX の扱いにすると USE_PTHREADS になり -pthread が付く）。_GNU_SOURCE は strdup と PATH_MAX のため。
---
 CMakeLists.txt | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4cad4b8..c205e11 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -222,6 +222,11 @@ if(WIN32)
 	list(APPEND CORE_VFS_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/util/vfs/vfs-fd.c ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/windows/vfs-w32.c)
 	file(GLOB OS_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/windows/*.c)
 	source_group("Windows-specific code" FILES ${OS_SRC})
+elseif(EMSCRIPTEN)
+	# retroboy-snap: WASM はスレッドなしで作る（SharedArrayBuffer・cross-origin isolation を要らなくする）
+	add_definitions(-D_GNU_SOURCE -DDISABLE_THREADING)
+	list(APPEND CORE_VFS_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/util/vfs/vfs-fd.c ${CMAKE_CURRENT_SOURCE_DIR}/src/util/vfs/vfs-dirent.c)
+	file(GLOB OS_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/posix/*.c)
 elseif(UNIX)
 	set(USE_PTHREADS ON)
 
